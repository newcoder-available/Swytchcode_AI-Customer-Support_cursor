# ResolveAI — server-only env (never expose to the browser)

# Optional: polish KB answers with OpenAI. App works without this (KB-only mode).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Escalate when confidence is below this (0–1)
CONFIDENCE_ESCALATE_THRESHOLD=0.55

# Gmail support inbox (Swytchcode OAuth — do not paste tokens in the UI)
# Connect with: swytchcode auth connect Gmail
SUPPORT_INBOX_EMAIL=
SUPPORT_LABEL=ResolveAI
SUPPORT_SUBJECT_PREFIX=
GMAIL_USER_ID=me
GMAIL_POLL_INTERVAL_MS=15000
GMAIL_AUTO_REPLY_CONFIDENCE=0.85
GMAIL_CLARIFY_CONFIDENCE=0.6
# Optional override only if Swytchcode auth credentials are unavailable:
# GMAIL_ACCESS_TOKEN=

# Execution channel:
#   dry-run     = real Swytchcode kernel with --dry-run (default)
#   live        = real provider calls via Swytchcode
#   simulation  = deterministic in-app fallback only (NOT Swytchcode)
SWYTCHCODE_MODE=dry-run
SWYTCHCODE_TIMEOUT_MS=25000
# Optional override if CLI is not on PATH:
# SWYTCHCODE_BIN=

# Stripe — used only on the server for stripe.charge.refund
STRIPE_SECRET_KEY=

# Intercom — used only on the server for ticket.create / ticket.get
INTERCOM_ACCESS_TOKEN=
INTERCOM_TICKET_TYPE_ID=1
